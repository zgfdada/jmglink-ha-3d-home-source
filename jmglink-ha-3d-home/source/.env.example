HA3D_MODE=standalone
PORT=8099
HA3D_DATA_DIR=./runtime/data
HA3D_ASSET_DIR=./runtime/assets
HA_URL=http://homeassistant.local:8123
# Set HA_TOKEN only in your untracked local .env file.

# Optional Gitea-backed public 3D model library. Keep credentials only in an
# ignored local environment file or your deployment secret store.
HA3D_MODEL_LIBRARY_GITEA_URL=https://gitea.example.com
# Optional internal API route when the public Gitea host is IPv6-only.
# HA3D_MODEL_LIBRARY_GITEA_API_URL=http://gitea-host-proxy:16667
HA3D_MODEL_LIBRARY_OWNER=owner
HA3D_MODEL_LIBRARY_REPO=jmglink-ha-3d-model-library
HA3D_MODEL_LIBRARY_BRANCH=main
HA3D_MODEL_LIBRARY_MODE=readonly
# HA3D_MODEL_LIBRARY_TOKEN=
